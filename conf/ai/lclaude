#!/usr/bin/env bash
set -euo pipefail

MODEL="${CLAUDE_LOCAL_MODEL:-qwen3.6:35b-mlx}"

# Start Ollama app on macOS if it is not already responding.
if ! curl -fsS http://localhost:11434/api/version >/dev/null 2>&1; then
  open -a Ollama >/dev/null 2>&1 || true
  for _ in {1..30}; do
    curl -fsS http://localhost:11434/api/version >/dev/null 2>&1 && break
    sleep 0.5
  done
fi

ANTHROPIC_AUTH_TOKEN=ollama \
ANTHROPIC_API_KEY="" \
ANTHROPIC_BASE_URL=http://localhost:11434 \
claude --model "$MODEL" "$@"


## Don't forget to add the script on the PATH. For example:
# echo 'export PATH="$HOME/.local/bin:$PATH"' >> <your_shellrc>

## For week models, it is better to limit the context window to compact earlier
## than the degradation will occur on the context saturation.

